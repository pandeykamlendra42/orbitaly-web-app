# Cloudflare Workers AI — used by the cf-flux image generation skill.
# Copy to .env and fill in real values. Never commit .env.
#
# CF_ACCOUNT_ID: Cloudflare dashboard → Workers & Pages → Account ID (32 hex chars)
# CF_API_TOKEN:  My Profile → API Tokens → Create Token, with the
#                "Workers AI" permission (Account → Workers AI → Read)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ---------------------------------------------------------------------------
# Survey module (/student-survey-v1)
# ---------------------------------------------------------------------------
# Where the survey API lives. Leave unset in development: the default is the
# relative path /api/survey/v1, which the Vite dev proxy forwards to the
# backend (keeping the browser same-origin, so CORS never comes into it).
# Set this for a deployed build, e.g.
#   VITE_SURVEY_API_BASE_URL=https://api.orbitaly.example/api/survey/v1
# VITE_SURVEY_API_BASE_URL=

# Where the dev proxy forwards /api. Defaults to the local Spring backend.
# VITE_SURVEY_API_PROXY_TARGET=http://localhost:8080

# Run the survey against the in-browser mock instead of a real backend —
# useful for demos with no server. See src/modules/survey/BACKEND.md.
# VITE_SURVEY_USE_MOCK=true
