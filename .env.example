# Cloudflare Workers AI — used by the cf-flux image generation skill.
# Copy to .env and fill in real values. Never commit .env.
#
# CF_ACCOUNT_ID: Cloudflare dashboard → Workers & Pages → Account ID (32 hex chars)
# CF_API_TOKEN:  My Profile → API Tokens → Create Token, with the
#                "Workers AI" permission (Account → Workers AI → Read)
CF_ACCOUNT_ID=
CF_API_TOKEN=
