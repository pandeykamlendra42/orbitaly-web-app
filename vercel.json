{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/survey/v1/auth/:path*",
      "destination": "https://uat.customerjourney.flyhifinance.com/api/survey/v1/auth/:path*"
    },
    {
      "source": "/api/survey/v1/surveys/:path*",
      "destination": "https://uat.customerjourney.flyhifinance.com/api/survey/v1/surveys/:path*"
    },
    {
      "source": "/api/survey/v1/admin/:path*",
      "destination": "https://uat.customerjourney.flyhifinance.com/api/survey/v1/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/survey-analytics",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
